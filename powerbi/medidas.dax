// =====================================================================
// Las 17 medidas del tablero EcoBottle AR
// En la "Vista de consulta DAX" de Power BI Desktop
// Los calculos de origen estan en sql/ y scripts/.
// Venta = pedido con is_sale = TRUE (estados PAID y FULFILLED).
// =====================================================================

DEFINE
    // ===== Ventas (fact_sales_order) =====
    MEASURE fact_sales_order[Pedidos] =
        CALCULATE ( COUNTROWS ( fact_sales_order ), fact_sales_order[is_sale] = TRUE () )

    MEASURE fact_sales_order[Ventas] =
        CALCULATE ( SUM ( fact_sales_order[total_amount] ), fact_sales_order[is_sale] = TRUE () )

    MEASURE fact_sales_order[Ticket Promedio] =
        DIVIDE ( [Ventas], [Pedidos] )

    MEASURE fact_sales_order[Ventas Mes Anterior] =
        CALCULATE ( [Ventas], DATEADD ( dim_date[full_date], -1, MONTH ) )

    MEASURE fact_sales_order[Variacion Ventas %] =
        DIVIDE ( [Ventas] - [Ventas Mes Anterior], [Ventas Mes Anterior] )

    MEASURE fact_sales_order[Participacion Ventas %] =
        DIVIDE ( [Ventas], CALCULATE ( [Ventas], ALLSELECTED ( dim_province ) ) )

    // ===== Productos (fact_sales_item) =====
    MEASURE fact_sales_item[Unidades Vendidas] =
        CALCULATE ( SUM ( fact_sales_item[quantity] ), fact_sales_item[is_sale] = TRUE () )

    MEASURE fact_sales_item[Ventas Items] =
        CALCULATE ( SUM ( fact_sales_item[line_total] ), fact_sales_item[is_sale] = TRUE () )

    MEASURE fact_sales_item[Ranking Producto] =
        RANKX ( ALLSELECTED ( dim_product[name] ), [Ventas Items], , DESC, DENSE )

    // ===== NPS (fact_nps) =====
    MEASURE fact_nps[Respuestas NPS] =
        COUNTROWS ( fact_nps )

    MEASURE fact_nps[Promotores] =
        CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[score] >= 9 )

    MEASURE fact_nps[Detractores] =
        CALCULATE ( COUNTROWS ( fact_nps ), fact_nps[score] <= 6 )

    MEASURE fact_nps[NPS] =
        DIVIDE ( [Promotores] - [Detractores], [Respuestas NPS] ) * 100

    // ===== Usuarios activos (fact_web_session) =====
    MEASURE fact_web_session[Usuarios Activos] =
        DISTINCTCOUNT ( fact_web_session[active_user_key] )

    MEASURE fact_web_session[Sesiones] =
        COUNTROWS ( fact_web_session )

    MEASURE fact_web_session[Usuarios Activos Mensual (promedio)] =
        AVERAGEX ( VALUES ( dim_date[year_month] ), [Usuarios Activos] )

    // ===== Logistica (fact_shipment) =====
    MEASURE fact_shipment[Dias de Entrega Promedio] =
        AVERAGE ( fact_shipment[delivery_days] )

EVALUATE
    ROW ( "Medidas definidas", 17 )
